#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// Helium IoT / LoRaWAN OTAA Credentials
// Get these from your Helium Console (console.helium.com) or ChirpStack LNS
//
// Copy this file to credentials.h and fill in your values:
//   cp credentials.h.example credentials.h
//   nano credentials.h

// joinEUI (AppEUI) — 8 bytes, can be all zeros for some networks
#define LORAWAN_JOIN_EUI  0x0000000000000000

// devEUI — 8 bytes, unique device identifier
// Example: 0x70B3D57ED0000000
#define LORAWAN_DEV_EUI   0x0000000000000000

// appKey — 16 bytes, AES-128 application key
#define LORAWAN_APP_KEY   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00

// nwkKey — 16 bytes, network key (same as appKey for LoRaWAN 1.0.x)
#define LORAWAN_NWK_KEY   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00

#endif
